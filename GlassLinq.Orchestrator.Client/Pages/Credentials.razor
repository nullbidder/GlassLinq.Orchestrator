@page "/tenant/credentials"
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="content-wrapper">
 

    <div class="table-controls d-flex mb-3 align-items-center">
        <div class="search-input-wrapper me-3">
            @* Added 'me-3' for margin-end *@
            <span class="bi bi-search search-icon"></span>
            <input type="text" placeholder="Search" class="orchestrator-search" />
        </div>
        <button class="btn-orchestrator-primary" @onclick="OpenModal">
            Add credentials store
        </button>
    </div>
    <div class="grid-container">
        <QuickGrid Items="@FilteredStores" Class="orchestrator-table">
            <PropertyColumn Property="@(p => p.Name)" Title="Name" Sortable="true" />
            <PropertyColumn Property="@(p => p.Host)" Title="Host" Sortable="true" />
            <PropertyColumn Property="@(p => p.Type)" Title="Type" Sortable="true" />
            
            <TemplateColumn Title="Robots Default Store">
                <div class="text-center">
                    @if (context.IsRobotsDefault)
                    {
                        <span class="bi bi-check2 text-info"></span>
                    }
                </div>
            </TemplateColumn>

            <TemplateColumn Title="Assets Default Store">
                <div class="text-center">
                    @if (context.IsAssetsDefault)
                    {
                        <span class="bi bi-check2 text-info"></span>
                    }
                </div>
            </TemplateColumn>

            <TemplateColumn Context="item">
                <button class="icon-btn"><span class="bi bi-three-dots-vertical"></span></button>
            </TemplateColumn>
        </QuickGrid>
    </div>
</div>

@code {
    private record CredentialStore(string Name, string Host, string Type, bool IsRobotsDefault, bool IsAssetsDefault);

    private IQueryable<CredentialStore> FilteredStores = new[]
    {
        new CredentialStore("Orchestrator Database", "Local", "Database", true, true),
        new CredentialStore("Delinea Vault", "delinea.glasslinq.cloud", "Plugin", false, false)
    }.AsQueryable();
  
        // 1. Variable to track if modal is visible
        private bool isModalOpen = false;

        // 2. Methods to change the state
        private void OpenModal() => isModalOpen = true;
        private void CloseModal() => isModalOpen = false;

        private void HandleCreate()
        {
            // Add your save logic here
            isModalOpen = false;
        }
    

}
@if (isModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-content-orchestrator">
            <div class="modal-header-bar">
                <div class="breadcrumbs">
                    <span>Tenant</span> <span class="bi bi-chevron-right"></span>
                    <span>Credentials</span> <span class="bi bi-chevron-right"></span>
                    <span>Stores</span> <span class="bi bi-chevron-right"></span>
                    <strong>Add Credentials Store</strong>
                </div>
                <span class="bi bi-x close-icon" @onclick="CloseModal"></span>
            </div>

            <div class="form-section">
                <div class="form-group">
                    <label class="orchestrator-label">Proxy</label>
                    <div class="d-flex align-items-center gap-2">
                        <select class="orchestrator-input flex-grow-1">
                            <option>Local</option>
                        </select>
                        <button class="btn icon-btn mb-3"><span class="bi bi-plus-lg text-info"></span></button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Type<span class="required-star">*</span></label>
                    <select class="orchestrator-input">
                        <option>Thycotic Secret Server</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Name<span class="required-star">*</span></label>
                    <input type="text" class="orchestrator-input" />
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Secret Server URL<span class="required-star">*</span></label>
                    <input type="text" class="orchestrator-input" />
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Rule Name<span class="required-star">*</span></label>
                    <input type="text" class="orchestrator-input" />
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Rule Key</label>
                    <div class="position-relative">
                        <input type="password" class="orchestrator-input" />
                        <span class="bi bi-eye-slash password-toggle"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Username Field<span class="required-star">*</span></label>
                    <input type="text" class="orchestrator-input" value="Username" />
                </div>

                <div class="form-group">
                    <label class="orchestrator-label">Password Field<span class="required-star">*</span></label>
                    <input type="text" class="orchestrator-input" value="Password" />
                </div>
            </div>

            <div class="modal-footer-actions">
                <button class="btn-orchestrator-cancel" @onclick="CloseModal">Cancel</button>
                <button class="btn-orchestrator-create" @onclick="HandleCreate">Create</button>
            </div>
        </div>
    </div>
}